{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@zhivex-ai/core": ["../../packages/core/src/index.ts"],
      "@zhivex-ai/openai": ["../../packages/openai/src/index.ts"],
      "@zhivex-ai/react": ["../../packages/react/src/index.ts"],
      "@zhivex-ai/sdk": ["../../packages/sdk/src/index.ts"]
    }
  },
  "include": ["env.d.ts", "app/**/*.ts", "app/**/*.tsx"]
}
