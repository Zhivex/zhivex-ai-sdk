{
  "name": "zhivex-ai-sdk",
  "private": true,
  "description": "TypeScript monorepo for a unified AI provider SDK for Bun and Node.",
  "type": "module",
  "packageManager": "bun@1.3.7",
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.3.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/clean-dist.ts && tsc -b --force",
    "changeset": "changeset",
    "docs:check": "bun run scripts/check-docs.ts",
    "test": "vitest run",
    "test:workflow-evaluation-gate": "bun run scripts/workflow-evaluation-ci-gate.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:openai": "vitest run --config vitest.integration.config.ts packages/openai/tests/openai.integration.test.ts",
    "test:integration:anthropic": "ZHIVEX_INTEGRATION_PROVIDER=anthropic vitest run --config vitest.integration.config.ts packages/anthropic/tests/anthropic.integration.test.ts packages/core/tests/*.integration.test.ts",
    "test:integration:gemini": "vitest run --config vitest.integration.config.ts packages/gemini/tests/gemini.integration.test.ts",
    "test:integration:meta": "ZHIVEX_INTEGRATION_PROVIDER=meta vitest run --config vitest.integration.config.ts packages/core/tests/*.integration.test.ts",
    "test:integration:deepseek": "ZHIVEX_INTEGRATION_PROVIDER=deepseek vitest run --config vitest.integration.config.ts packages/deepseek/tests/deepseek.integration.test.ts packages/core/tests/*.integration.test.ts",
    "test:integration:zai": "ZHIVEX_INTEGRATION_PROVIDER=zai vitest run --config vitest.integration.config.ts packages/zai/tests/zai.integration.test.ts packages/core/tests/*.integration.test.ts",
    "test:integration:qwen": "ZHIVEX_INTEGRATION_PROVIDER=qwen vitest run --config vitest.integration.config.ts packages/qwen/tests/qwen.integration.test.ts packages/core/tests/*.integration.test.ts",
    "test:integration:agents": "ZHIVEX_AGENT_LIVE_CERTIFICATION=1 vitest run --config vitest.integration.config.ts packages/core/tests/agent-live.integration.test.ts",
    "test:integration:agents-realtime": "ZHIVEX_LIVE_AGENT_CERTIFICATION=1 vitest run --config vitest.integration.config.ts packages/core/tests/agent-realtime-live.integration.test.ts",
    "test:integration:workflows": "vitest run --config vitest.integration.config.ts packages/core/tests/workflow-providers.integration.test.ts packages/core/tests/workflow-postgres.integration.test.ts",
    "test:integration:workflows-postgres": "ZHIVEX_WORKFLOW_POSTGRES_CERTIFICATION=1 vitest run --config vitest.integration.config.ts packages/core/tests/workflow-postgres.integration.test.ts",
    "test:integration:workflows-sqlite": "bun run scripts/workflow-sqlite-certification.ts",
    "test:integration:ollama": "OLLAMA_INTEGRATION=1 ZHIVEX_INTEGRATION_PROVIDER=ollama vitest run --config vitest.integration.config.ts packages/core/tests/*.integration.test.ts",
    "test:integration:vertex": "vitest run --config vitest.integration.config.ts packages/vertex/tests/vertex.integration.test.ts",
    "smoke:providers": "bun run scripts/provider-smoke-report.ts && bun run test:integration",
    "smoke:dist": "bun run build && bun run packages/agents/tests/dist-entrypoints.smoke.ts",
    "smoke:packages": "bun run build && bun run scripts/package-consumer-smoke.ts",
    "smoke:packages:agents-live": "bun run build && bun run scripts/agent-package-live-smoke.ts",
    "smoke:packages:workflows-postgres": "bun run build && bun run scripts/workflow-package-postgres-smoke.ts",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version",
    "release:check": "bun run scripts/check-release-readiness.ts",
    "release:check:next": "bun run scripts/check-release-readiness.ts --tag=next",
    "release:verify": "bun run scripts/check-release-readiness.ts --postpublish",
    "release": "bun run scripts/check-release-readiness.ts --require-oidc --release-batch-file=$RUNNER_TEMP/zhivex-release-batch.json && bun run build && changeset publish && bun run scripts/check-release-readiness.ts --postpublish --release-batch-file=$RUNNER_TEMP/zhivex-release-batch.json",
    "release:next": "bun run scripts/check-release-readiness.ts --tag=next --require-oidc --release-batch-file=$RUNNER_TEMP/zhivex-release-batch.json && bun run build && changeset publish --tag next && bun run scripts/check-release-readiness.ts --postpublish --tag=next --release-batch-file=$RUNNER_TEMP/zhivex-release-batch.json"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "happy-dom": "^20.11.2",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.23",
    "tinyglobby": "^0.2.16",
    "vite": "^8.1.4"
  },
  "patchedDependencies": {
    "read-yaml-file@1.1.0": "patches/read-yaml-file@1.1.0.patch"
  }
}
