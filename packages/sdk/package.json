{
  "name": "@zhivex-ai/sdk",
  "version": "1.11.0",
  "description": "Unified high-level SDK for multi-provider AI workflows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "zhivex-ai": "dist/cli.js"
  },
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.3.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./evals": {
      "types": "./dist/evals.d.ts",
      "import": "./dist/evals.js"
    },
    "./beta": {
      "types": "./dist/beta.d.ts",
      "import": "./dist/beta.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-ai-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/Zhivex/zhivex-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zhivex/zhivex-ai-sdk/issues"
  },
  "keywords": [
    "ai",
    "sdk",
    "llm",
    "providers",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zhivex-ai/core": "~1.10.0"
  }
}
