{
  "name": "@zhivex-ai/react",
  "version": "0.1.0",
  "description": "Headless React chat state, streaming transport, and customizable components for Zhivex AI SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-ai-sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Zhivex/zhivex-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zhivex/zhivex-ai-sdk/issues"
  },
  "keywords": [
    "ai",
    "chat",
    "react",
    "sdk",
    "streaming"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@zhivex-ai/core": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  }
}
