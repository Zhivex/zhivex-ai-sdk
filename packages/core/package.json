{
  "name": "@zhivex-ai/core",
  "version": "1.9.1",
  "description": "Shared contracts and runtime helpers for Zhivex AI SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.3.7"
  },
  "imports": {
    "#secure-id": {
      "types": "./secure-id-internal.d.ts",
      "browser": "./dist/secure-id.js",
      "node": "./dist/secure-id-node.js",
      "default": "./dist/secure-id.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.js"
    },
    "./workflows": {
      "types": "./dist/workflows-entry.d.ts",
      "import": "./dist/workflows-entry.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./ui": {
      "types": "./dist/ui-entry.d.ts",
      "import": "./dist/ui-entry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "secure-id-internal.d.ts",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-ai-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Zhivex/zhivex-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zhivex/zhivex-ai-sdk/issues"
  },
  "keywords": [
    "ai",
    "sdk",
    "llm",
    "core",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
