{
  "name": "@zhivex-ai/core",
  "version": "1.31.0",
  "description": "Shared contracts and runtime helpers for Zhivex AI SDK.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18.18.0",
    "bun": ">=1.3.7"
  },
  "imports": {
    "#secure-id": {
      "types": "./secure-id-internal.d.ts",
      "browser": "./dist/secure-id.js",
      "node": "./dist/secure-id-node.js",
      "default": "./dist/secure-id.js"
    },
    "#realtime-transport": {
      "types": "./realtime-transport-internal.d.ts",
      "browser": "./dist/realtime-browser.js",
      "node": "./dist/realtime-node.js",
      "default": "./dist/realtime-browser.js"
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime-entry.js"
    },
    "./workflows": {
      "types": "./dist/workflows-entry.d.ts",
      "import": "./dist/workflows-entry.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./ui": {
      "types": "./dist/ui-entry.d.ts",
      "import": "./dist/ui-entry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./generation": {
      "types": "./dist/generation-entry.d.ts",
      "import": "./dist/generation-entry.js"
    },
    "./provider": {
      "types": "./dist/provider-entry.d.ts",
      "import": "./dist/provider-entry.js"
    },
    "./catalog": {
      "types": "./dist/catalog-entry.d.ts",
      "import": "./dist/catalog-entry.js"
    },
    "./agents": {
      "types": "./dist/agents-entry.d.ts",
      "import": "./dist/agents-entry.js"
    },
    "./mcp-http": {
      "types": "./dist/mcp-http.d.ts",
      "import": "./dist/mcp-http.js"
    },
    "./mcp-stdio": {
      "types": "./dist/mcp-stdio.d.ts",
      "browser": "./dist/mcp-stdio-browser.js",
      "bun": "./dist/mcp-stdio.js",
      "node": "./dist/mcp-stdio.js",
      "import": "./dist/mcp-stdio.js",
      "default": "./dist/mcp-stdio.js"
    },
    "./evals": {
      "types": "./dist/evals-entry.d.ts",
      "import": "./dist/evals-entry.js"
    },
    "./realtime": {
      "types": "./dist/realtime-entry.d.ts",
      "import": "./dist/realtime-entry.js"
    },
    "./control-plane": {
      "types": "./dist/control-plane-entry.d.ts",
      "import": "./dist/control-plane-entry.js"
    },
    "./ops": {
      "types": "./dist/ops-entry.d.ts",
      "import": "./dist/ops-entry.js"
    },
    "./beta": {
      "types": "./dist/beta-entry.d.ts",
      "import": "./dist/beta-entry.js"
    },
    "./experimental": {
      "types": "./dist/experimental-entry.d.ts",
      "import": "./dist/experimental-entry.js"
    },
    "./provider-google": {
      "types": "./dist/provider-google.d.ts",
      "import": "./dist/provider-google.js"
    }
  },
  "files": [
    "dist",
    "secure-id-internal.d.ts",
    "README.md",
    "realtime-transport-internal.d.ts"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-ai-sdk.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Zhivex/zhivex-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Zhivex/zhivex-ai-sdk/issues"
  },
  "keywords": [
    "ai",
    "sdk",
    "llm",
    "core",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.3",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
